// prisma/schema.prisma — Enterprise RDBMS Schema (PRD §5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_TRUSTEE
  CLERK_OPERATOR
  AUDITOR_CA
}

enum FundType {
  GENERAL_VOLUNTARY
  DESIGNATED_PURPOSE
  CORPUS_11_1_D
}

enum PaymentMethod {
  CASH
  UPI_QR
  SUBSCRIPTION
  CHEQUE
  BANK_TRANSFER
}

enum TransactionStatus {
  PENDING_PAYMENT
  CHEQUE_RECEIVED_UNCLEARED
  REALIZED
  BOUNCED
  FAILED
  REVERSED
}

enum AccountType {
  ASSET
  LIABILITY_FUND
  INCOME
  EXPENSE
}

enum VoucherType {
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
}

enum ExpenseScale {
  MAJOR
  PETTY
}

enum SpecifiedPersonType {
  NONE
  TRUSTEE
  SETTLOR
  SUBSTANTIAL_CONTRIBUTOR
  RELATIVE_OF_TRUSTEE
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  phone     String?
  role      Role       @default(ADMIN_TRUSTEE)
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

model Donor {
  id                  String              @id @default(cuid())
  donorCode           String              @unique
  fullName            String
  phone               String              @unique
  email               String?
  panNumber           String?
  addressLine1        String
  addressLine2        String?
  city                String
  state               String
  pinCode             String
  specifiedPersonType SpecifiedPersonType @default(NONE)
  lifetimeDonated     Decimal             @default(0) @db.Decimal(14, 2)
  donations           Donation[]
  subscriptions       Subscription[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([panNumber])
  @@index([phone])
}

model Donation {
  id                       String            @id @default(cuid())
  receiptNumber            String            @unique
  financialYear            String
  donorId                  String
  donor                    Donor             @relation(fields: [donorId], references: [id])
  amount                   Decimal           @db.Decimal(14, 2)
  fundType                 FundType          @default(GENERAL_VOLUNTARY)
  paymentMethod            PaymentMethod
  status                   TransactionStatus @default(PENDING_PAYMENT)

  corpusDirectionConfirmed Boolean           @default(false)
  corpusDirectionNote      String?

  razorpayOrderId    String? @unique
  razorpayPaymentId  String? @unique
  razorpayQrId       String?
  razorpaySignature  String?
  subscriptionId     String?
  utrNumber          String?

  chequeNumber      String?
  chequeDate        DateTime?
  chequeBankName    String?
  chequeBranchIfsc  String?
  chequeClearedDate DateTime?
  bounceReason      String?

  journalEntryId  String?       @unique
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  receiptPdfUrl   String?
  donorNotifiedAt DateTime?
  attachments     Attachment[]
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([financialYear, status])
  @@index([donorId])
}

model Subscription {
  id                     String   @id @default(cuid())
  razorpaySubscriptionId String   @unique
  donorId                String
  donor                  Donor    @relation(fields: [donorId], references: [id])
  planAmount             Decimal  @db.Decimal(14, 2)
  frequency              String
  fundType               FundType @default(GENERAL_VOLUNTARY)
  status                 String
  shortUrl               String?
  createdAt              DateTime @default(now())
}

model BudgetCategory {
  id          String             @id @default(cuid())
  name        String
  description String?
  ledgerId    String
  ledger      LedgerAccount      @relation(fields: [ledgerId], references: [id])
  allocations BudgetAllocation[]
  expenses    Expense[]
}

model BudgetAllocation {
  id                String         @id @default(cuid())
  financialYear     String
  budgetCategoryId  String
  budgetCategory    BudgetCategory @relation(fields: [budgetCategoryId], references: [id])
  allocatedAmount   Decimal        @db.Decimal(14, 2)
  alertThresholdPct Int            @default(80)

  @@unique([financialYear, budgetCategoryId])
}

model Expense {
  id               String            @id @default(cuid())
  voucherNumber    String            @unique
  financialYear    String
  expenseDate      DateTime
  scale            ExpenseScale      @default(MAJOR)
  vendorName       String
  vendorPan        String?
  description      String
  amount           Decimal           @db.Decimal(14, 2)
  tdsAmount        Decimal           @default(0) @db.Decimal(14, 2)
  netPaidAmount    Decimal           @db.Decimal(14, 2)
  paymentMethod    PaymentMethod
  status           TransactionStatus @default(REALIZED)

  utrOrRefNumber   String?
  chequeNumber     String?
  chequeDate       DateTime?
  paidFromLedgerId String

  isDisallowedSec11   Boolean @default(false)
  disallowanceReason  String?
  isCapitalAsset      Boolean @default(false)
  isRelatedPartySec13 Boolean @default(false)

  budgetCategoryId String
  budgetCategory   BudgetCategory @relation(fields: [budgetCategoryId], references: [id])
  journalEntryId   String?        @unique
  journalEntry     JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  attachments      Attachment[]
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([financialYear, budgetCategoryId])
  @@index([expenseDate, vendorName])
}

model LedgerAccount {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String           @unique
  tallyParentGroup String
  accountType      AccountType
  isSec11_5Mode    Boolean          @default(false)
  openingBalance   Decimal          @default(0) @db.Decimal(14, 2)
  journalLines     JournalLine[]
  budgetCategories BudgetCategory[]
}

model JournalEntry {
  id             String        @id @default(cuid())
  voucherNumber  String        @unique
  voucherType    VoucherType
  financialYear  String
  entryDate      DateTime
  narration      String
  isReversal     Boolean       @default(false)
  reversedFromId String?
  lines          JournalLine[]
  donation       Donation?
  expense        Expense?
  createdById    String
  createdAt      DateTime      @default(now())

  @@index([financialYear, entryDate])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerId       String
  ledger         LedgerAccount @relation(fields: [ledgerId], references: [id])
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
}

model Attachment {
  id         String    @id @default(cuid())
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String
  fileUrl    String
  donationId String?
  donation   Donation? @relation(fields: [donationId], references: [id])
  expenseId  String?
  expense    Expense?  @relation(fields: [expenseId], references: [id])
  uploadedBy String
  uploadedAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model VoucherSequence {
  id            String      @id @default(cuid())
  financialYear String
  voucherType   VoucherType
  lastSequence  Int         @default(0)

  @@unique([financialYear, voucherType])
}
