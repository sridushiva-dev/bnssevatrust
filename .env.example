# Local Postgres. On Neon+Vercel: pooled URL → DATABASE_URL, direct URL → DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bnst_trust?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bnst_trust?schema=public"

# One-time cloud seed at /setup (set in Vercel before first deploy)
SETUP_SECRET="change-me-to-a-long-random-string"

# Optional: Tally XML company name
TALLY_COMPANY_NAME="BHAGAVAN NAAMA SATHSANGAM SEVA TRUST"

RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# Attachment storage: local (default) or s3
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
